{
  "data_path": "./data/voc_dataset_1+2_vs_3_with_unknown.mat",
  "save_path": "./result/unknown_val_seed_selection/all_masks.pt",
  "seed": 42,
  "num_cluster": 3,
  "experiment_repeats": 100,
  "repeats": 20,
  "epochs": 300,
  "batch_size": 16,
  "split_outer": [
    0.8,
    0.2
  ],
  "split_inner": [
    0.75,
    0.25
  ],
  "num_blocks": 4,
  "head_dim": 256,
  "lr_logist": 1e-05,
  "lr_classifier": 0.0005,
  "wd_logist": 0.0001,
  "wd_classifier": 0.005,
  "sparsity_lambda": 0.01,
  "temp_start": 1.0,
  "temp_end": 0.3,
  "panel_threshold": 0.5,
  "evaluation_set": "val",
  "sealed_test_set_used": false,
  "split_seed_strategy": "seed + 100000 + out_idx",
  "model_seed_strategy": "seed + out_idx * repeats + in_idx",
  "torch_version": "2.7.0+cu128",
  "numpy_version": "2.2.6"
}